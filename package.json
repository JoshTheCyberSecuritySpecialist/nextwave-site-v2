{
  "name": "vite-react-typescript-starter",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "start:api": "node server/production-server.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:m5": "node --test tests/m5-*.test.mjs tests/website-publishing.test.mjs tests/website-connected-tools.test.mjs tests/production-server.test.mjs tests/checkout-routing.test.mjs",
    "test:m6": "node --test tests/m6-*.test.mjs",
    "test:e2e": "playwright test",
    "migrate:status": "node scripts/migration-status.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.app.json"
  },
  "dependencies": {
    "@google/genai": "^2.31.0",
    "@supabase/supabase-js": "^2.57.4",
    "framer-motion": "^12.23.25",
    "lucide-react": "^0.344.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.11.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.13",
    "@eslint/js": "^9.9.1",
    "@playwright/test": "^1.49.1",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.18",
    "eslint": "^9.9.1",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.11",
    "globals": "^15.9.0",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.3.0",
    "vite": "^5.4.2"
  }
}
