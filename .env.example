# Browser Supabase (required for CRM login and workspace UI).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional. Checkout is shown when this is empty or test.
# live hides checkout and does not enable real charges.
VITE_CHECKOUT_MODE=

# Optional local API origin. Empty uses the Vite /api proxy. Production builds ignore this
# and call https://nextwave-site-v2.onrender.com directly.
VITE_API_BASE_URL=

# Render only. Placeholders. Never commit real values or copy them into VITE_ variables.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYMENT_TOKEN_SECRET=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
APP_BASE_URL=https://nextwavedigitalsolution.com
# Keep test until a reviewed migration accepts livemode payment RPCs.
# STRIPE_MODE=live refuses API startup in Milestone 1.
STRIPE_MODE=test
NODE_ENV=production

# Optional. Render only. Blog draft generation stays off when this is empty.
# Checkout still starts. Never copy this into a VITE_ variable.
# Create the key in Google AI Studio. Do not attach a billed Google Cloud project.
GEMINI_API_KEY=

# Optional. Defaults to gemini-3.5-flash-lite. The only other accepted value is gemini-3.8-flash.
GEMINI_MODEL=

# Optional. Render only. Booking confirmation/reminder delivery stays off when either is empty.
# Never copy these into a VITE_ variable.
RESEND_API_KEY=
RESEND_FROM=

# API process on Render: npm run start:api  (node server/production-server.mjs)
# Stripe webhook endpoint, on Render, not the Vercel domain:
# https://nextwave-site-v2.onrender.com/api/webhook
