# Optional. Checkout is shown when this is empty or test.
# live hides checkout and does not enable real charges.
VITE_CHECKOUT_MODE=

# Optional local API origin. Empty uses the Vite /api proxy. Production builds ignore this
# and call https://nextwave-site-v2.onrender.com directly.
VITE_API_BASE_URL=

# Render only. Placeholders. Never commit real values or copy them into VITE_ variables.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYMENT_TOKEN_SECRET=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
APP_BASE_URL=https://nextwavedigitalsolution.com
STRIPE_MODE=test
NODE_ENV=production

# Stripe webhook endpoint, on Render, not the Vercel domain:
# https://nextwave-site-v2.onrender.com/api/webhook
